API_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not put the token in a frontend build or a committed file.
API_TOKEN=
CORS_ORIGINS=https://michaelabatetsu.github.io
# Bounded CPU execution time after a job starts, separate from queue waiting.
# Measure the target VM; a 120-frame dense scene is not guaranteed to fit 300s.
JOB_TIMEOUT_SECONDS=300
# Opt-in smaller genuine MobileNet forward batches (1-16); default unchanged.
# This does not bound all-crop preprocessing or make Render Free deployable.
DEEPSORT_EMBEDDER_BATCH_SIZE=16
# Review and explicitly approve the frontend's nine public camera sources.
# HTTPS only; no wildcard domains. Add only verified segment/redirect CDN hosts.
APPROVED_STREAM_URLS=["https://mcleansfs3.us-east-1.skyvdn.com/rtplive/R2_061/playlist.m3u8","https://mcleansfs3.us-east-1.skyvdn.com/rtplive/R2_062/playlist.m3u8","https://mcleansfs3.us-east-1.skyvdn.com/rtplive/R2_063/playlist.m3u8","https://mcleansfs3.us-east-1.skyvdn.com/rtplive/R2_064/playlist.m3u8","https://mcleansfs3.us-east-1.skyvdn.com/rtplive/R2_065/playlist.m3u8","https://mcleansfs3.us-east-1.skyvdn.com/rtplive/R2_066/playlist.m3u8","https://mcleansfs3.us-east-1.skyvdn.com/rtplive/R2_067/playlist.m3u8","https://mcleansfs3.us-east-1.skyvdn.com/rtplive/R2_068/playlist.m3u8","https://mcleansfs3.us-east-1.skyvdn.com/rtplive/R2_069/playlist.m3u8"]
STREAM_HOSTS=mcleansfs3.us-east-1.skyvdn.com
